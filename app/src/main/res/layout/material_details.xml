<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/materialDetailsHeaderTv"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Material Details"
            android:textColor="#1E293B"
            android:textSize="20sp" />

        <FrameLayout
            android:id="@+id/colormMaterialDetailsFrame"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/rounded_frame">

            <ImageView
                android:id="@+id/notebookIv"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/notebook"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/MaterialDetailsTitleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/roboto_bold"
            android:text="Information"
            android:textColor="#1E293B"
            android:textSize="18sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:id="@+id/materialCourseIv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="20dp"
                    app:layout_constraintBottom_toBottomOf="@+id/materialNameTv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/materialHeaderNameTv"
                    app:srcCompat="@drawable/book"
                    app:tint="#0891B2" />

                <TextView
                    android:id="@+id/materialHeaderNameTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/roboto"
                    android:text="Material Name"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    app:layout_constraintStart_toEndOf="@+id/materialCourseIv"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/materialNameTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Intro to Android"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/materialHeaderNameTv" />

                <View
                    android:id="@+id/div1"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#F1F5F9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/materialNameTv" />

                <ImageView
                    android:id="@+id/materialDetailsDescriptionIv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/materialDetailsDescriptionTv"
                    app:layout_constraintStart_toStartOf="@+id/materialCourseIv"
                    app:layout_constraintTop_toTopOf="@+id/materialDetailsHeaderDescriptionTv"
                    app:srcCompat="@drawable/description"
                    app:tint="#0891B2" />

                <TextView
                    android:id="@+id/materialDetailsHeaderDescriptionTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/roboto"
                    android:text="Description"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/div1" />

                <TextView
                    android:id="@+id/materialDetailsDescriptionTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="This is a comprehensive guide to Android development"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/materialDetailsHeaderDescriptionTv" />

                <View
                    android:id="@+id/div2"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#F1F5F9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/materialDetailsDescriptionTv" />

                <ImageView
                    android:id="@+id/materialDetailsTopicIv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/materialDetailsTopicTv"
                    app:layout_constraintStart_toStartOf="@+id/materialCourseIv"
                    app:layout_constraintTop_toTopOf="@+id/materialDetailsHeaderTopicTv"
                    app:srcCompat="@drawable/topic"
                    app:tint="#0891B2" />

                <TextView
                    android:id="@+id/materialDetailsHeaderTopicTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/roboto"
                    android:text="Topic"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/div2" />

                <TextView
                    android:id="@+id/materialDetailsTopicTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Mobile Development"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/materialDetailsHeaderTopicTv" />

                <View
                    android:id="@+id/div2_5"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#F1F5F9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/materialDetailsTopicTv" />

                <ImageView
                    android:id="@+id/materialDetailsTypeIv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/materialDetailsTypeTv"
                    app:layout_constraintStart_toStartOf="@+id/materialCourseIv"
                    app:layout_constraintTop_toTopOf="@+id/materialDetailsHeaderTypeTv"
                    app:srcCompat="@drawable/notebook"
                    app:tint="#0891B2" />

                <TextView
                    android:id="@+id/materialDetailsHeaderTypeTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/roboto"
                    android:text="Type"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/div2_5" />

                <TextView
                    android:id="@+id/materialDetailsTypeTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="PDF Document"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/materialDetailsHeaderTypeTv" />

                <View
                    android:id="@+id/div3"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#F1F5F9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/materialDetailsTypeTv" />


                <ImageView
                    android:id="@+id/materialDetailsAuthorIv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/materialDetailsAuthorTv"
                    app:layout_constraintStart_toStartOf="@+id/materialCourseIv"
                    app:layout_constraintTop_toTopOf="@+id/materialDetailsAuthorHeaderTv"
                    app:srcCompat="@drawable/person"
                    app:tint="#0891B2" />

                <TextView
                    android:id="@+id/materialDetailsAuthorHeaderTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/roboto"
                    android:text="Uploaded By"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/div3" />

                <TextView
                    android:id="@+id/materialDetailsAuthorTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="John Doe"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/materialDetailsAuthorHeaderTv" />

                <View
                    android:id="@+id/div4"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#F1F5F9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/materialDetailsAuthorTv" />

                <ImageView
                    android:id="@+id/materialDetailsDateIv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/materialDetailsDateTv"
                    app:layout_constraintStart_toStartOf="@+id/materialCourseIv"
                    app:layout_constraintTop_toTopOf="@+id/materialDetailsHeaderDateTv"
                    app:srcCompat="@android:drawable/ic_menu_my_calendar"
                    app:tint="#0891B2" />

                <TextView
                    android:id="@+id/materialDetailsHeaderDateTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/roboto"
                    android:text="Date Uploaded"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/div4" />

                <TextView
                    android:id="@+id/materialDetailsDateTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Dec 12, 2024"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/materialHeaderNameTv"
                    app:layout_constraintTop_toBottomOf="@+id/materialDetailsHeaderDateTv" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <FrameLayout
            android:id="@+id/downloadBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/gradient_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/downloadIv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/stat_sys_download_done"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/downloadTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/roboto_bold"
                    android:text="Download Material"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</ScrollView>